{
  "info": {
    "name": "Restaurant Management API",
    "description": "API for managing restaurants and their menu items",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Restaurants",
      "item": [
        {
          "name": "List Restaurants",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/restaurants?page=1&per_page=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "10"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Restaurant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurant\": {\n    \"name\": \"Gourmet Garden\",\n    \"address\": \"123 Culinary St, Food City\",\n    \"phone\": \"0812-3456-7890\",\n    \"opening_hours\": \"09:00 - 21:00\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/restaurants",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Show Restaurant Details",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants",
                "{{restaurantId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Restaurant",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"restaurant\": {\n    \"name\": \"Updated Gourmet Garden\",\n    \"address\": \"456 Tasty Rd, Food City\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants",
                "{{restaurantId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Restaurant",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants",
                "{{restaurantId}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Menu Items",
      "item": [
        {
          "name": "List Menu Items for Restaurant",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/menu_items?category=Main Course&page=1&per_page=5",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants",
                "{{restaurantId}}",
                "menu_items"
              ],
              "query": [
                {
                  "key": "category",
                  "value": "Main Course"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "per_page",
                  "value": "5"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Menu Item for Restaurant",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"menu_item\": {\n    \"name\": \"Truffle Pasta\",\n    \"description\": \"Pasta with creamy truffle sauce\",\n    \"price\": 15.99,\n    \"category\": \"Main Course\",\n    \"is_available\": true\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/restaurants/{{restaurantId}}/menu_items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "restaurants",
                "{{restaurantId}}",
                "menu_items"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Update Menu Item",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"menu_item\": {\n    \"name\": \"Truffle Pasta (New Style)\",\n    \"price\": 16.50,\n    \"is_available\": true\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/menu_items/{{menuItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu_items",
                "{{menuItemId}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Delete Menu Item",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/menu_items/{{menuItemId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "menu_items",
                "{{menuItemId}}"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ],
